<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Narrow first-release permission set: network only (device
         enrollment, polling, reporting), plus BATTERY_STATS-free
         BatteryManager reads and ConnectivityManager (no extra runtime
         permission needed for connection-type-only reads on API 26+).
         No SEND_SMS, CALL_PHONE, camera, accessibility-service binding,
         or MediaProjection permission is declared: those capability
         tiers are separate, later, and deliberately not implemented in
         this pass even though the backend allowlist now accepts them. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera notes (ui.CameraNotesActivity): still NO CAMERA permission. The
         photo is taken by the system camera app the human launches and presses
         the shutter in (ACTION_IMAGE_CAPTURE via TakePicture), written into this
         app's cache through the FileProvider below, OCR'd on-device (bundled
         ML Kit Latin model, no network), then deleted. Package-visibility
         query needed on API 30+ to resolve the camera app. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.AIHangoutCompanion">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Camera -> on-device OCR -> editable -> explicit save (A5 lane).
             Not exported: reachable only from inside this app (one launch
             entrypoint to be added in MainActivity by its owner). -->
        <activity
            android:name=".ui.CameraNotesActivity"
            android:exported="false"
            android:label="Camera notes" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera-notes.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_note_paths" />
        </provider>
    </application>
</manifest>
