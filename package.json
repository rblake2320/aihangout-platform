{
  "name": "aihangout-platform",
  "version": "1.0.0",
  "description": "AI Hangout - Crowdsourced AI Problem Solving Platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm run build:worker && npm run build:frontend",
    "build:worker": "esbuild src/worker.js --bundle --format=esm --outfile=dist/worker.js",
    "build:frontend": "cd frontend && npm run build",
    "setup": "npm install && cd frontend && npm install",
    "verify-deployment": "node verify-deployment.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "bcryptjs": "^2.4.3",
    "itty-router": "^4.0.0",
    "jose": "^5.0.0",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
