{
  "forbidden_hosts": [
    "aihangout.ai"
  ],
  "url_normalize": [
    {
      "pattern": "(/assets/[A-Za-z0-9_.-]+?)-[A-Za-z0-9_-]{8}(\\.(?:js|css|woff2?|svg|png))",
      "replacement": "$1-<hash>$2"
    },
    {
      "pattern": "/(problems|problem|profile|learning|users|solutions)/[0-9a-fA-F-]{1,36}(?=$|[/?#])",
      "replacement": "/$1/:id"
    },
    {
      "pattern": "([?&](?:t|ts|_|cb|nonce)=)[^&#]*",
      "replacement": "$1<v>"
    },
    {
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z",
      "replacement": "<timestamp>"
    }
  ],
  "ignore_requests": [
    "/api/live/count",
    "/api/sessions/guest-heartbeat",
    "/api/analytics/batch",
    "/favicon",
    "/cdn-cgi/",
    "/api/events/batch"
  ],
  "dom": {
    "key_selectors": [
      "nav",
      "form",
      "h1",
      "button[type=submit]",
      "#username",
      "#email",
      "#password",
      "#confirmPassword",
      "#acceptTos",
      "#title",
      "#category",
      "#description",
      "[role=alert]"
    ]
  },
  "ignore_storage_keys": [
    "session:guestSessionId",
    "session:aihangout_session_id",
    "session:aih_tel_session"
  ]
}
