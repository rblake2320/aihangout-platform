{
  "start_url": {
    "url": "__ORIGIN__/login",
    "query": []
  },
  "actions": [
    {
      "step_id": "form-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#email"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "fill-email",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "#email"
      },
      "value": {
        "source": "secret",
        "secret_id": "gateEmail"
      }
    },
    {
      "step_id": "fill-password",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "#password"
      },
      "value": {
        "source": "secret",
        "secret_id": "gateBadPassword"
      }
    },
    {
      "step_id": "submit",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "button[type=submit]"
      }
    },
    {
      "step_id": "response-settle",
      "action": "wait_for_timeout",
      "duration_ms": 1500
    }
  ],
  "capture": {
    "after_each_step": [
      "url",
      "dom",
      "storage"
    ],
    "at_end": [
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ],
    "network": {
      "request_body": true,
      "response_body": true,
      "header_values": false
    }
  },
  "secrets": [
    {
      "secret_id": "gateEmail",
      "environment_variable": "GATE_EMAIL"
    },
    {
      "secret_id": "gateBadPassword",
      "environment_variable": "GATE_BAD_PASSWORD"
    }
  ]
}
